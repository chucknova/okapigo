{
  "name": "@okapigo/web",
  "version": "0.0.0",
  "private": true,
  "description": "OkapiGo guest web: catalogue, tour pages, checkout, trip hub, operator site (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budget.js",
    "preview": "vite preview",
    "tokens": "node scripts/write-tokens.js",
    "test": "vitest run",
    "e2e": "vite build && pnpm --filter @okapigo/simulators build && pnpm --filter @okapigo/operator build && playwright test"
  },
  "dependencies": {
    "@okapigo/shared": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@okapigo/db": "workspace:*",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "uqr": "0.1.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
