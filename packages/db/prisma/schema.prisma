// schema.prisma — the single source of truth for OkapiGo's database tables.
//
// How this file is used:
//   1. You edit the models below.
//   2. `pnpm db:migrate --name <what-changed>` compares this file with the database and writes
//      a SQL migration into prisma/migrations/. Those SQL files are committed, so every
//      machine (yours, CI, the demo host) builds exactly the same database.
//   3. Prisma regenerates the client, so `prisma.user.findMany()` etc. match these models.
//
// Conventions used throughout:
//   - Model names are singular PascalCase (User); @@map gives snake_case plural table names
//     (users). Field names are camelCase in JavaScript (operatorId) and @map makes the
//     column snake_case (operator_id). snake_case is the usual PostgreSQL style and means
//     raw SQL (which we'll write for row locks and ledger checks) needs no "quoted" names.
//   - Every business row carries `operatorId`. The operator is the TENANT: one tour company.
//     The MVP has one operator (Ìrìn Lagos Tours), but "visitor sandboxes" in the PRD create
//     a throwaway copy per visitor, so isolation between operators matters from day one.
//   - IDs are UUIDs: safe to expose in URLs (not guessable like 1, 2, 3) and can be created
//     offline by the PWA later without clashing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Operator: the tenant (a tour company using OkapiGo)
// ---------------------------------------------------------------------------
model Operator {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  // Used in public URLs, e.g. okapigo.app/irin-lagos-tours. Unique across all operators.
  slug         String   @unique
  // ISO 4217 currency code. NGN only in the MVP; USD/GBP arrive in v1.
  currency     String   @default("NGN") @db.Char(3)
  // IANA time zone. Departure times are shown in the operator's local time.
  timeZone     String   @default("Africa/Lagos") @map("time_zone")
  // The look of every guest page (MKT-08, stage 12g): lagoon · classic · earth, and light ·
  // dark · auto (follow the guest's phone). Only the look: links and content never change.
  websiteStyle String   @default("lagoon") @map("website_style")
  websiteMode  String   @default("auto") @map("website_mode")
  // Tax and fee settings fed into the pricing pipeline (packages/shared/src/pricing.js).
  // Shape: { tax: { name, basisPoints, inclusive } | null, fees: [{ name, type, ... }] }
  // validated by OperatorPricingSchema. Default: prices INCLUDE 7.5% VAT, no extra fees.
  // (Illustrative: not tax advice.)
  // How long checkout holds keep seats while a guest pays (INV-23), in minutes.
  holdMinutes  Int      @default(15) @map("hold_minutes")
  // Where the operator works, for headings like "Tours in Lagos" (stage 12b). Optional:
  // without it the catalogue says "Our tours". More business details arrive in stage 12g.
  city         String?
  // How guests reach the operator, shown as "Call" and "WhatsApp" on the trip hub (stage 12f).
  // E.164 like the lead phone ("+2348031234567"). Optional: without them the buttons hide.
  // (The rest of the business details, tagline, about, email, socials, come in stage 12g.)
  phone        String?
  whatsapp     String?
  pricing      Json     @default("{\"tax\": {\"name\": \"VAT\", \"basisPoints\": 750, \"inclusive\": true}, \"fees\": []}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                Role[]
  users                User[]
  products             Product[]
  cancellationPolicies CancellationPolicy[]
  ledgerAccounts       LedgerAccount[]
  ledgerTransactions   LedgerTransaction[]
  payments             Payment[]
  paymentLinks         PaymentLink[]
  refunds              Refund[]
  notifications        Notification[]
  guestRequests        GuestRequest[]

  @@map("operators")
}

// ---------------------------------------------------------------------------
// Role: a named set of permissions (ACC-05)
// ---------------------------------------------------------------------------
// Each operator gets three PRESET roles (owner, manager, guide) and can create CUSTOM
// roles. A role's `permissions` is a JSON object mapping a module to an access level:
//   { "bookings": "edit", "products": "view", "payments": "none", ... }
// Session 3 adds the middleware that enforces these on every API route.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  operatorId  String   @map("operator_id") @db.Uuid
  // A stable machine name ("owner", "manager", "guide", or e.g. "front-desk").
  key         String
  name        String
  // true for the three built-in roles: they can't be deleted or renamed.
  isPreset    Boolean  @default(false) @map("is_preset")
  // JSONB: flexible shape, still queryable in PostgreSQL. Validated with Zod in the API.
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // onDelete: Cascade = deleting an operator deletes its roles (used by sandbox cleanup).
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  users    User[]

  // Role keys are unique *within* an operator: two operators can each have a "guide" role.
  @@unique([operatorId, key])
  // Needed so User can reference (role id + operator id) together. See User.role below.
  @@unique([id, operatorId])
  @@map("roles")
}

// ---------------------------------------------------------------------------
// User: a STAFF member who signs in (owner, manager, guide, ...)
// ---------------------------------------------------------------------------
// Guests do not have accounts in the MVP; they're stored with their bookings (session 7).
model User {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  name       String
  // Staff sign in with a one-time code sent to email OR phone (ACC-01), so each is optional
  // but at least one must be present. That rule is a CHECK constraint added in the migration
  // SQL, because Prisma's schema language can't express it.
  // Unique across the whole platform: a code sent to an address must identify one person.
  email      String?  @unique
  // Stored in E.164 format, e.g. +2348031234567, so the same number is always written the same way.
  phone      String?  @unique
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  // A COMPOSITE foreign key: the user's (roleId, operatorId) must match a role's
  // (id, operatorId). This makes it IMPOSSIBLE, at the database level, to give a Lagos
  // Tours staff member a role that belongs to another operator. A bug in our code can't
  // bypass it, which is the point of putting the rule in the database.
  // onDelete: NoAction = you can't delete a role while staff still hold it. (NoAction is
  // checked at the end of each statement rather than immediately like Restrict. Deleting a
  // whole operator, which cascades to both roles and users, is covered by a test in
  // packages/db/test/schema.test.js. See HoldAddOn.addOn for why that matters.)
  role Role @relation(fields: [roleId, operatorId], references: [id, operatorId], onDelete: NoAction)

  sessions Session[]

  @@index([operatorId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// OtpChallenge: one "we sent you a code" attempt (ACC-01)
// ---------------------------------------------------------------------------
// Created when someone asks for a sign-in or sign-up code; consumed when they enter it.
// Not tenant data: it exists BEFORE we know who the person is, so it has no operator_id.
model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  // "login" = existing staff signing in; "signup" = a new business being created.
  purpose     String
  // Where the code went: "email" or "phone", and the normalised address/number.
  channel     String
  destination String
  // HMAC-SHA256 of the code, never the code itself. If the database leaked, the codes
  // in it would be useless (and they expire in minutes anyway).
  codeHash    String    @map("code_hash")
  // For sign-ups: the business and owner details, held here until the code is verified,
  // so nothing is created for people who never finish signing up.
  payload     Json?
  // Wrong guesses so far. After 5 the challenge is dead, which stops brute-forcing a
  // 6-digit code (1,000,000 possibilities, but only 5 tries).
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at")
  // Set when the code is used successfully. A code works once.
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Finding "recent challenges for this address" (rate limiting, verification) must be fast.
  @@index([destination, createdAt])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// Session: a signed-in device
// ---------------------------------------------------------------------------
// After a correct code, the API gives the client a random token. The client sends it on
// every request (Authorization: Bearer <token>). We store only its hash, like a password.
// Signing out (or deactivating a user) revokes sessions immediately, which is the main
// reason we use database sessions instead of JWTs.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // SHA-256 of the token. Unique, so looking a session up by token is one index lookup.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  // Helps staff recognise their devices later ("Chrome on Android").
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ===========================================================================
// THE CATALOGUE: what an operator sells (INV-01, INV-05, INV-10)
// ===========================================================================
//
// MONEY RULE: every amount is an Int of KOBO (₦1 = 100 kobo), and the field name ends in
// "Kobo". Never a float: floats can't represent most decimals exactly (0.1 + 0.2 !== 0.3
// in JavaScript), and a payments system can't be off by even a kobo. Int holds up to
// 2,147,483,647 kobo (about ₦21.4 million), far more than any single tour price.
//
// TIMESTAMPS: new tables use @db.Timestamptz ("timestamp with time zone"). Prisma stores UTC
// either way, but timestamptz makes that explicit to anyone reading raw SQL.

// ---------------------------------------------------------------------------
// Product: one tour (INV-01)
// ---------------------------------------------------------------------------
model Product {
  id              String @id @default(uuid()) @db.Uuid
  operatorId      String @map("operator_id") @db.Uuid
  // Unique per operator, used in booking links: /irin-lagos-tours/heritage-walk
  slug            String
  title           String
  // One or two sentences for cards and link previews; `description` is the full story.
  summary         String
  description     String
  // "draft" = being set up (not bookable), "published" = on sale, "archived" = retired.
  status          String @default("draft")
  durationMinutes Int    @map("duration_minutes")
  // A short word or two about HOW the tour runs: "Walking", "Boat", "Van, pickup" (stage 12b,
  // shown on tour cards and pages). Optional.
  activityLabel   String? @map("activity_label")
  // "Arrive by 08:50": how many minutes before the start guests should be at the meeting
  // point (trip hub, stage 12f). Optional: without it the line hides. CHECK: 0–120.
  arriveMinutesEarly Int? @map("arrive_minutes_early")
  // Seats per departure unless a schedule says otherwise (session 5).
  defaultCapacity Int    @map("default_capacity")

  // JSONB: structured content validated by Zod in packages/shared/src/schemas/products.js.
  // These are read as a whole (for the website, trip hub and AI companion) and never
  // queried field by field, so JSON is simpler than a table for each.
  //   meetingPoint: { name, address, lat, lng }
  //   stops:        [{ name, description }]           in visiting order
  //   photos:       [{ url, alt }]                    alt text is required (accessibility)
  //   pickupPoints: [{ name, address }]               e.g. the Lekki van tour's hotel pickups
  //   faqs:         [{ question, answer }]            also feeds the AI companion (GST-16)
  meetingPoint Json @map("meeting_point")
  stops        Json @default("[]")
  photos       Json @default("[]")
  pickupPoints Json @default("[]") @map("pickup_points")
  faqs         Json @default("[]")

  // PostgreSQL text arrays: simple lists of short strings.
  inclusions  String[] @default([])
  exclusions  String[] @default([])
  whatToBring String[] @default([]) @map("what_to_bring")

  // Which cancellation policy applies (BKG-26). New bookings use its LATEST version.
  cancellationPolicyId String? @map("cancellation_policy_id") @db.Uuid

  // Deposits (BKG-06, stage 11c): the share a guest may pay up front, in basis points
  // (3000 = 30%), with the balance due 7 days before the trip (packages/shared/src/deposits.js).
  // null = no deposit, pay in full. CHECK: 1–9999 (0% or 100% wouldn't be a deposit).
  depositBasisPoints Int? @map("deposit_basis_points")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator           Operator            @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId, operatorId], references: [id, operatorId], onDelete: Cascade)
  priceCategories    PriceCategory[]
  addOns             AddOn[]
  schedules          Schedule[]
  departures         Departure[]
  bookings           Booking[]

  @@unique([operatorId, slug])
  // Lets children reference (product id + operator id) together: same tenant-safety
  // trick as users → roles in session 2.
  @@unique([id, operatorId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// PriceCategory: a price for a kind of traveller (INV-05)
// ---------------------------------------------------------------------------
// Ìrìn's tours use adult (13+), child (3–12) and infant (0–2). The pricing pipeline
// (session 6) picks a category from each traveller's age using minAge/maxAge.
model PriceCategory {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  // Stable machine name: "adult", "child", "infant" (or e.g. "student" for a custom one).
  key        String
  name       String
  // Inclusive age range. maxAge = null means "and older" (adults).
  minAge     Int      @map("min_age")
  maxAge     Int?     @map("max_age")
  amountKobo Int      @map("amount_kobo")
  sortOrder  Int      @default(0) @map("sort_order")
  // Archived instead of deleted: bookings will point at categories (session 7), and a
  // deleted price would break the history of every booking that used it.
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId, operatorId], references: [id, operatorId], onDelete: Cascade)

  @@unique([productId, key])
  @@map("price_categories")
}

// ---------------------------------------------------------------------------
// AddOn: an optional extra with its own price and stock (INV-10)
// ---------------------------------------------------------------------------
// e.g. an extra tasting plate on the Street Food Crawl, or a beach chair at Tarkwa Bay.
model AddOn {
  id                String   @id @default(uuid()) @db.Uuid
  operatorId        String   @map("operator_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  name              String
  description       String   @default("")
  priceKobo         Int      @map("price_kobo")
  // How many can be sold PER DEPARTURE (the food vendor makes 10 extra plates a night).
  // null = unlimited. Sold counts are tracked per departure once bookings exist (session 7).
  stockPerDeparture Int?     @map("stock_per_departure")
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product        @relation(fields: [productId, operatorId], references: [id, operatorId], onDelete: Cascade)
  holdItems     HoldAddOn[]
  bookingAddOns BookingAddOn[]

  @@map("add_ons")
}

// ===========================================================================
// SCHEDULES AND DEPARTURES (INV-03)
// ===========================================================================
//
//   Schedule  = a RULE   "Heritage Walk, daily at 09:00 from 1 Dec, except 25 Dec"
//   Departure = an EVENT "Heritage Walk, Tue 2 Dec 2026, 09:00 Lagos", with its own seats
//
// Departures are generated from schedules for a rolling window (60 days ahead) by
// syncScheduleDepartures() in src/departures.js. Guests book DEPARTURES, never schedules.

// ---------------------------------------------------------------------------
// Schedule: a repeating rule for when a product runs
// ---------------------------------------------------------------------------
model Schedule {
  id         String     @id @default(uuid()) @db.Uuid
  operatorId String     @map("operator_id") @db.Uuid
  productId  String     @map("product_id") @db.Uuid
  // Calendar dates (no time of day), in the operator's time zone.
  startDate  DateTime   @map("start_date") @db.Date
  endDate    DateTime?  @map("end_date") @db.Date
  // Weekdays that run: 0 = Sunday … 6 = Saturday. Daily = all seven.
  daysOfWeek Int[]      @map("days_of_week")
  // Local start times, "HH:MM", in the operator's time zone.
  times      String[]
  // Seats per departure; null = use the product's defaultCapacity.
  capacity   Int?
  // "Exceptions per date": dates the rule would produce but which don't run.
  skipDates  DateTime[] @default([]) @map("skip_dates") @db.Date
  // Inactive schedules stop generating; their future EMPTY departures are removed.
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  product    Product     @relation(fields: [productId, operatorId], references: [id, operatorId], onDelete: Cascade)
  departures Departure[]

  @@map("schedules")
}

// ---------------------------------------------------------------------------
// Departure: one bookable occurrence of a product (INV-02, INV-03)
// ---------------------------------------------------------------------------
// The most important row for "never sell the same seat twice". From session 6, holds and
// bookings LOCK this row (SELECT … FOR UPDATE) while they change the seat counts, and the
// CHECK constraint below is the last line of defence: the database refuses any write that
// would put more people on a departure than it has seats.
model Departure {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  // Set for departures generated from a schedule; null for one-off ("custom") departures.
  scheduleId String?  @map("schedule_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  capacity   Int
  seatsSold  Int      @default(0) @map("seats_sold")
  seatsHeld  Int      @default(0) @map("seats_held")
  // "scheduled" = running; "cancelled" = called off (e.g. weather at Tarkwa Bay).
  status     String   @default("scheduled")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product  Product   @relation(fields: [productId, operatorId], references: [id, operatorId], onDelete: Cascade)
  // SetNull: if a schedule row were ever deleted, its departures (and their bookings) stay.
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  holds    Hold[]
  bookings Booking[]

  // A product can't have two departures at the same moment. This also makes generating
  // departures idempotent: running the generator twice can't create duplicates.
  @@unique([productId, startsAt])
  // Lets bookings reference (departure id + operator id) together (tenant safety).
  @@unique([id, operatorId])
  // The availability query: "departures of product X between these dates".
  @@index([operatorId, startsAt])
  @@map("departures")
}

// ===========================================================================
// CHECKOUT HOLDS (INV-23)
// ===========================================================================

// ---------------------------------------------------------------------------
// Hold: seats (and add-ons) set aside while a guest pays
// ---------------------------------------------------------------------------
// Created by createHold() in src/holds.js, which LOCKS the departure row while it checks
// and claims seats. Released exactly once, by the guest/staff, by its expiry job, or by the
// sweeper, whichever comes first. Session 8 turns a paid hold into a booking ("converted").
model Hold {
  id          String    @id @default(uuid()) @db.Uuid
  operatorId  String    @map("operator_id") @db.Uuid
  departureId String    @map("departure_id") @db.Uuid
  // Every traveller takes a seat, infants included (a boat seat and life jacket each).
  seats       Int
  // active    → seats are counted in departures.seats_held
  // released  → given back early (guest left / staff cancelled)
  // expired   → given back because time ran out
  // converted → became a booking (session 8); seats move from "held" to "sold"
  status      String    @default("active")
  // Where the hold came from: staff, web, whatsapp, ota. Bookings inherit it (BKG-23).
  channel     String
  // The travellers as entered ([{ age }] or [{ categoryKey }]) and the PRICE SNAPSHOT: the
  // full priced basket at the moment of holding. The guest pays what they were shown,
  // even if the operator changes prices during checkout.
  travellers  Json
  quote       Json
  totalKobo   Int       @map("total_kobo")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  // When it stopped being active (released, expired or converted).
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  departure Departure   @relation(fields: [departureId], references: [id], onDelete: Cascade)
  addOns    HoldAddOn[]
  booking   Booking?

  // The sweeper's query: "active holds that have passed their expiry".
  @@index([status, expiresAt])
  @@index([departureId, status])
  @@map("holds")
}

// ---------------------------------------------------------------------------
// HoldAddOn: add-ons claimed by a hold (they have limited stock per departure too)
// ---------------------------------------------------------------------------
model HoldAddOn {
  holdId   String @map("hold_id") @db.Uuid
  addOnId  String @map("add_on_id") @db.Uuid
  quantity Int

  hold  Hold  @relation(fields: [holdId], references: [id], onDelete: Cascade)
  // Cascade. Two delete paths reach this table when an operator is deleted
  // (operator → product → add-on, and operator → departure → hold → here), and Postgres
  // runs each cascade as its own internal statement. Restrict AND NoAction both fired
  // before the second path had removed these rows, so deleting a whole operator (sandbox
  // cleanup) failed. The app never hard-deletes add-ons (they're archived), so in practice
  // this cascade only runs when a whole operator is deleted. Found in session 7.
  addOn AddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  // A composite PRIMARY key: one row per (hold, add-on).
  @@id([holdId, addOnId])
  @@map("hold_add_ons")
}

// ===========================================================================
// BOOKINGS (BKG-23, BKG-25)
// ===========================================================================
//
// DELETE RULES. Session 7 taught us that when two cascade paths reach a table, anything but
// CASCADE can break deleting a whole operator (sandbox cleanup). So every link below
// cascades. That's only safe because the app NEVER deletes departures, holds or products
// that have bookings: departures are only removed by the schedule sync, which skips any
// departure with bookings; holds and products are never deleted at all.

// ---------------------------------------------------------------------------
// Booking: one purchase of seats on one departure
// ---------------------------------------------------------------------------
model Booking {
  id              String  @id @default(uuid()) @db.Uuid
  operatorId      String  @map("operator_id") @db.Uuid
  // Human-friendly, unique per operator: "ILT-7K4Q2M". Said over the phone, printed on tickets.
  reference       String
  departureId     String  @map("departure_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  // The checkout hold this booking was created with. Its seats move from held to sold
  // when the booking is confirmed or paid.
  holdId          String  @unique @map("hold_id") @db.Uuid
  // Where it was sold: staff, web, whatsapp, ota (copied from the hold).
  channel         String
  // See packages/shared/src/booking-status.js. Changed ONLY by transitionBooking().
  status          String  @default("held")
  currency        String  @default("NGN") @db.Char(3)
  // The price snapshot from the hold: what the guest agreed to pay.
  quote           Json
  totalKobo       Int     @map("total_kobo")
  // Updated by payments (session 10). balance due = totalKobo − amountPaidKobo.
  amountPaidKobo  Int     @default(0) @map("amount_paid_kobo")
  // The cancellation policy VERSION this booking was sold under (BKG-26). Versions never
  // change, so this pins the exact terms the guest agreed to.
  policyVersionId String? @map("policy_version_id") @db.Uuid
  // Set when cancelled or marked no-show: what the policy (or staff) says goes back.
  // Paying it out is session 10 (Paystack refunds), which moves the booking to "refunded".
  refundDueKobo   Int     @default(0) @map("refund_due_kobo")

  // THE LEAD BOOKER: the person paying and the contact for the booking. They may or may not
  // also be a traveller (a parent booking for their teenagers, say). Guests don't have
  // accounts in the MVP, so these live on the booking.
  leadName         String   @map("lead_name")
  leadEmail        String?  @map("lead_email")
  leadPhone        String?  @map("lead_phone")
  // Consent capture (PRD privacy): when they accepted the booking terms, and whether they
  // agreed to marketing messages.
  termsAcceptedAt  DateTime @map("terms_accepted_at") @db.Timestamptz(3)
  marketingConsent Boolean  @default(false) @map("marketing_consent")
  notes            String   @default("")

  // The pickup point the guest chose, COPIED from the product: { name, address }. A copy, not
  // a reference, so renaming a pickup point later can't change where this guest is waiting.
  // Required on tours that have pickup points (Lekki), null on the others (stage 11b).
  pickupPoint Json? @map("pickup_point")
  // (No guest token column: guest links are SIGNED from the booking id, see guest-links.js.)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  departure     Departure                  @relation(fields: [departureId, operatorId], references: [id, operatorId], onDelete: Cascade)
  product       Product                    @relation(fields: [productId, operatorId], references: [id, operatorId], onDelete: Cascade)
  hold          Hold                       @relation(fields: [holdId], references: [id], onDelete: Cascade)
  policyVersion CancellationPolicyVersion? @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  travellers    Traveller[]
  addOns        BookingAddOn[]
  events        BookingEvent[]
  ledgerEntries LedgerEntry[]
  payments      Payment[]
  paymentLinks  PaymentLink[]
  refunds       Refund[]
  notifications Notification[]
  guestRequests GuestRequest[]

  @@unique([operatorId, reference])
  @@index([operatorId, status])
  @@index([departureId])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Traveller: one person on a booking (BKG-25)
// ---------------------------------------------------------------------------
// Feeds manifests and check-in (session 15) and age-based prices.
model Traveller {
  id            String    @id @default(uuid()) @db.Uuid
  operatorId    String    @map("operator_id") @db.Uuid
  bookingId     String    @map("booking_id") @db.Uuid
  // Order as entered (1, 2, 3…), so lists always show travellers the same way.
  position      Int
  name          String
  age           Int
  // The price category they were charged as ("adult", "child", "infant").
  categoryKey   String    @map("category_key")
  // Free text, shown on the manifest: "vegetarian", "nut allergy"…
  dietaryNeeds  String    @default("") @map("dietary_needs")
  email         String?
  phone         String?
  // pending → present / late / no_show (check-in, session 15)
  checkInStatus String    @default("pending") @map("check_in_status")
  checkedInAt   DateTime? @map("checked_in_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
  @@map("travellers")
}

// ---------------------------------------------------------------------------
// BookingAddOn: add-ons bought on a booking (counted against stock while seats are sold)
// ---------------------------------------------------------------------------
model BookingAddOn {
  bookingId String @map("booking_id") @db.Uuid
  addOnId   String @map("add_on_id") @db.Uuid
  quantity  Int
  // Price per unit at booking time (part of the snapshot, kept for receipts).
  unitKobo  Int    @map("unit_kobo")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn   AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([bookingId, addOnId])
  @@map("booking_add_ons")
}

// ---------------------------------------------------------------------------
// BookingEvent: the booking's timeline (BKG-23). APPEND-ONLY: never updated or deleted.
// ---------------------------------------------------------------------------
// Every status change, and other notable moments, with who did it and when. Answers
// "what happened to this booking?" when a guest calls.
model BookingEvent {
  id          String   @id @default(uuid()) @db.Uuid
  operatorId  String   @map("operator_id") @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  // "created", "status_changed", "traveller_updated", "note"…
  type        String
  fromStatus  String?  @map("from_status")
  toStatus    String?  @map("to_status")
  // Who did it: a staff "user", the "guest", or the "system" (e.g. the expiry job).
  actorType   String   @map("actor_type")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  // Extra detail, e.g. { reason: "hold_expired" } or { changed: { name: [old, new] } }.
  data        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

// ===========================================================================
// CANCELLATION POLICIES (BKG-26)
// ===========================================================================
//
//   CancellationPolicy         "Standard" (the thing products point at)
//   CancellationPolicyVersion  v1, v2, … the actual rules. IMMUTABLE: a database trigger
//                              refuses any UPDATE. Changing the rules = adding a version.
//
// A booking points at the version it was sold under, so changing the policy tomorrow never
// changes what an existing guest agreed to. The engine is packages/shared/src/cancellation.js.

model CancellationPolicy {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  operator Operator                    @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  versions CancellationPolicyVersion[]
  products Product[]

  @@unique([operatorId, name])
  @@unique([id, operatorId])
  @@map("cancellation_policies")
}

model CancellationPolicyVersion {
  id                      String   @id @default(uuid()) @db.Uuid
  policyId                String   @map("policy_id") @db.Uuid
  version                 Int
  // [{ hoursBefore, refundBasisPoints }], validated by PolicyTermsSchema.
  rules                   Json
  noShowRefundBasisPoints Int      @map("no_show_refund_basis_points")
  depositRefundable       Boolean  @map("deposit_refundable")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  policy   CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([policyId, version])
  @@map("cancellation_policy_versions")
}

// ===========================================================================
// THE LEDGER (PAY-22): double-entry, append-only
// ===========================================================================
//
//   LedgerAccount      Ìrìn's 7 accounts (Paystack clearing, Tour sales, Refunds payable…)
//   LedgerTransaction  one money EVENT ("payment received for ILT-7K4Q2M")
//   LedgerEntry        its lines: each a debit OR a credit on one account
//
// Guarantees enforced by the DATABASE (see the migration SQL):
//   - every transaction's debits = credits, checked at COMMIT by a deferred trigger
//   - entries and transactions can't be UPDATED or DELETED (except when a whole
//     operator is deleted). Corrections are new, reversing transactions.
// Posting rules live in packages/shared/src/ledger.js; writing them in src/ledger.js.

model LedgerAccount {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  // "1100", "4000"… and the key used in code ("PROVIDER_CLEARING", "TOUR_SALES"…)
  code       String
  key        String
  name       String
  // asset, liability, revenue, expense; `normal` is the side that increases it.
  type       String
  normal     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  operator Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  entries  LedgerEntry[]

  @@unique([operatorId, code])
  @@unique([operatorId, key])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  operatorId     String   @map("operator_id") @db.Uuid
  // What kind of event: payment_received, payment_fee, refund_owed, refund_paid,
  // unallocated_receipt, receipt_allocated, adjustment, reversal
  type           String
  // IDEMPOTENCY: the same event always has the same key (e.g. "refund-owed:<booking id>").
  // Posting it a second time (a retried job, a duplicate webhook) finds the existing
  // transaction instead of counting the money twice.
  idempotencyKey String   @map("idempotency_key")
  description    String
  // When the money event happened (may differ from when we recorded it).
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  // Set on a reversal: the transaction it undoes.
  reversesId     String?  @unique @map("reverses_id") @db.Uuid
  // Who posted it: a staff user, or null for the system.
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  operator   Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
  reverses   LedgerTransaction? @relation("Reversal", fields: [reversesId], references: [id], onDelete: Cascade)
  reversedBy LedgerTransaction? @relation("Reversal")

  @@unique([operatorId, idempotencyKey])
  @@index([operatorId, occurredAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  operatorId    String   @map("operator_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  // Optional links, so "everything about booking ILT-7K4Q2M" (or one payment) is one query.
  bookingId     String?  @map("booking_id") @db.Uuid
  paymentId     String?  @map("payment_id") @db.Uuid
  // Exactly one is above zero (a CHECK enforces it). Integer kobo, like all money.
  debitKobo     Int      @default(0) @map("debit_kobo")
  creditKobo    Int      @default(0) @map("credit_kobo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  booking     Booking?          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment     Payment?          @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@index([bookingId])
  @@map("ledger_entries")
}

// ===========================================================================
// PAYMENTS (PAY-02 and friends, stage 10b)
// ===========================================================================
//
// One row per payment ATTEMPT. Created (status "initiated") BEFORE we call the provider,
// so every provider transaction has a local record, even if the call fails halfway or a
// webhook arrives first. Only a VERIFIED webhook (stage 10c) moves it to "succeeded".
model Payment {
  id                    String    @id @default(uuid()) @db.Uuid
  operatorId            String    @map("operator_id") @db.Uuid
  // Null for an UNMATCHED RECEIPT (stage 10d): money that arrived without a booking we
  // could match it to, until staff allocate it (allocatedAt is then set).
  bookingId             String?   @map("booking_id") @db.Uuid
  // Which adapter handled it: "simulator" or "paystack".
  provider              String
  // card, bank_transfer… (Paystack can report the channel actually used, set in 10c.)
  method                String
  // What it was for: full, deposit, balance, custom (payment links, 10d).
  purpose               String
  amountKobo            Int       @map("amount_kobo")
  currency              String    @default("NGN") @db.Char(3)
  // See packages/shared/src/payment-status.js.
  status                String    @default("initiated")
  // OUR reference ("OKG-…"), sent to the provider and echoed back in webhooks. Globally
  // unique: the PRD's "idempotent on the Paystack reference" hinges on it.
  reference             String    @unique
  // From the provider: its own transaction id, the hosted checkout page, its fee.
  providerTransactionId String?   @map("provider_transaction_id")
  authorizationUrl      String?   @map("authorization_url")
  feeKobo               Int?      @map("fee_kobo")
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(3)
  failureReason         String?   @map("failure_reason")
  // How the guest actually paid, as reported by the provider (card, bank, ussd…).
  channel               String?
  // Set when a human must look at it, e.g. money that arrived after the hold expired
  // (HOLD_EXPIRED_BEFORE_PAYMENT) or more money than was owed (OVERPAID).
  reviewReason          String?   @map("review_reason")
  // --- Stage 10d -----------------------------------------------------------------
  // For an unmatched receipt: the booking it was PROBABLY meant for (e.g. a transfer of the
  // wrong amount for a known payment). A hint for staff, deliberately not a foreign key.
  suggestedBookingId    String?   @map("suggested_booking_id") @db.Uuid
  // When staff matched an unmatched receipt to a booking.
  allocatedAt           DateTime? @map("allocated_at") @db.Timestamptz(3)
  // Set when the payment was made through a payment link (PAY-05).
  paymentLinkId         String?   @map("payment_link_id") @db.Uuid
  // Stage 10e: how much of THIS payment is being or has been refunded (requested, pending or
  // processed refunds; a failed refund gives its amount back). Never more than amountKobo.
  refundedKobo          Int       @default(0) @map("refunded_kobo")
  createdById           String?   @map("created_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // A direct link to the operator, so deleting a business also deletes unmatched receipts
  // (which have no booking to cascade through).
  operator      Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentLink   PaymentLink?  @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  refunds       Refund[]

  @@index([bookingId])
  @@index([operatorId, allocatedAt])
  @@index([operatorId, createdAt])
  @@map("payments")
}

// ===========================================================================
// WEBHOOK EVENTS (stage 10c)
// ===========================================================================
//
// Every signed event the payment provider sends us, stored ONCE, before anything else.
//   - Paystack retries an event until we answer 200, so the same event can arrive many
//     times. The unique (provider, dedupKey) index keeps one copy; the rest are ignored.
//   - Storing first and processing in a background job means we answer Paystack in
//     milliseconds, and a crash mid-processing loses nothing: the event is still here.
//   - The raw payload is kept for audits and for replaying events in tests.
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  // e.g. "charge.success"
  eventType   String    @map("event_type")
  // What makes an event "the same event": "<event type>:<provider transaction id>".
  // (Paystack events carry no event id of their own.)
  dedupKey    String    @map("dedup_key")
  payload     Json
  // received → processed / ignored / needs_review; failed after the last retry.
  status      String    @default("received")
  // Why it was ignored or needs review, in a few words (e.g. UNKNOWN_REFERENCE).
  outcome     String?
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, dedupKey])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// PaymentLink: "pay ₦X towards booking ILT-7K4Q2M" as a shareable URL (PAY-05)
// ---------------------------------------------------------------------------
// The URL contains a random token (192 bits). Like session tokens, only its SHA-256 HASH is
// stored: someone reading the database can't rebuild working links. The full URL is shown
// once, when the link is created.
model PaymentLink {
  id          String   @id @default(uuid()) @db.Uuid
  operatorId  String   @map("operator_id") @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  amountKobo  Int      @map("amount_kobo")
  // deposit, balance or custom (same words as payments.purpose)
  purpose     String
  // active → paid / cancelled / expired
  status      String   @default("active")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([bookingId])
  @@map("payment_links")
}

// ---------------------------------------------------------------------------
// Refund: money going back to a guest, against ONE payment (PAY-08, stage 10e)
// ---------------------------------------------------------------------------
// "Refunds to the original method": a provider refund is tied to the transaction the money
// came in on, so a booking paid in two parts (deposit + balance) may need two refunds.
//
//   requested → pending (the provider accepted it) → processed (money left) / failed
//
// Recorded BEFORE calling the provider, like payments. The ledger is only written when the
// provider confirms the money actually left (a verified refund.processed webhook).
model Refund {
  id               String    @id @default(uuid()) @db.Uuid
  operatorId       String    @map("operator_id") @db.Uuid
  // Null when refunding an unmatched receipt (money that was never applied to a booking).
  bookingId        String?   @map("booking_id") @db.Uuid
  paymentId        String    @map("payment_id") @db.Uuid
  provider         String
  amountKobo       Int       @map("amount_kobo")
  status           String    @default("requested")
  reason           String
  // The provider's id for the refund: how webhooks and reconciliation find it again.
  providerRefundId String?   @map("provider_refund_id")
  failureReason    String?   @map("failure_reason")
  createdById      String?   @map("created_by_id") @db.Uuid
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRefundId])
  @@index([bookingId])
  @@index([status, createdAt])
  @@map("refunds")
}

// ===========================================================================
// NOTIFICATIONS: the OUTBOX of messages to send (stage 11d)
// ===========================================================================
//
// A row = "this message should be sent" (to a guest) or "this needs attention" (for staff).
// The daily balance job WRITES rows; session 14 SENDS guest rows by email and WhatsApp and
// marks them sent. Writing first and sending separately is the "outbox" pattern: deciding
// what to send never depends on the email or WhatsApp service being up, and a failed send
// can be retried without deciding again.
//
//   audience "guest", kind "balance_reminder"   7, 3 and 1 days before the balance is due
//   audience "staff", kind "balance_overdue"    the due date has passed; staff decide what
//                                                to do (nothing is cancelled automatically)
//
// status: pending → sent (delivered) | cancelled (no longer needed: paid, cancelled, trip
// passed) | dismissed (staff handled the alert).
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  operatorId String    @map("operator_id") @db.Uuid
  bookingId  String    @map("booking_id") @db.Uuid
  audience   String
  kind       String
  // ONE per booking per key, enforced by the unique index below: "balance_reminder:7",
  // "balance_reminder:3", "balance_reminder:1", "balance_overdue". However often the job runs,
  // a guest gets each reminder at most once.
  key        String
  // What the message needs, frozen when it was decided: amount, due date, days left…
  data       Json
  status     String    @default("pending")
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, key])
  // "Open staff alerts for this operator" and "guest messages waiting to be sent".
  @@index([operatorId, audience, status])
  @@index([status, audience])
  @@map("notifications")
}


// ---------------------------------------------------------------------------
// GuestRequest: "Ask Ìrìn" from the trip hub (stage 12f-2, decided 2026-11-17)
// ---------------------------------------------------------------------------
// A guest asks the operator to change the date, to cancel (e.g. for more back than the
// policy gives), or something else. Nothing about the booking changes until staff act:
// they answer by WhatsApp or email, then mark the request answered. Staff can already
// cancel with a different refund (bookings: edit + payments: edit).
//
//   status: open → answered
model GuestRequest {
  id           String    @id @default(uuid()) @db.Uuid
  operatorId   String    @map("operator_id") @db.Uuid
  bookingId    String    @map("booking_id") @db.Uuid
  // change_date · cancel · other
  kind         String
  message      String
  status       String    @default("open")
  // Staff's own note when they mark it answered ("Moved to Sun 6 Dec").
  staffNote    String?   @map("staff_note")
  answeredAt   DateTime? @map("answered_at") @db.Timestamptz(3)
  answeredById String?   @map("answered_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // The staff list: "open requests, oldest first".
  @@index([operatorId, status, createdAt])
  @@index([bookingId])
  @@map("guest_requests")
}
