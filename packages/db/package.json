{
  "name": "@okapigo/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed script and the shared database client",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@okapigo/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "vitest": "5.1.0"
  }
}
