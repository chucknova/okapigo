{
  "name": "@okapigo/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed script and the shared database client",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./testing": "./src/testing.js",
    "./reset": "./src/seed/reset.js"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force && prisma db seed",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "demo:reset": "node src/seed/reset-run.js"
  },
  "dependencies": {
    "@okapigo/media": "workspace:*",
    "@okapigo/payments": "workspace:*",
    "@okapigo/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "sharp": "0.35.5",
    "vitest": "5.1.0"
  }
}
