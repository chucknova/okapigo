# Dependencies — reinstalled from the lockfile, never committed
node_modules/

# Build output and tool caches
dist/
.turbo/
coverage/

# Secrets. Only .env.example (with fake/test values) is committed.
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/

# Playwright's results and traces (end-to-end tests)
test-results/
playwright-report/

# Uploaded photos and logos on the local disk (19b-1): made by the app, not source code.
# On the deployed app they live in Cloudflare R2.
.data/
