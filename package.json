{
  "name": "okapigo",
  "private": true,
  "description": "OkapiGo \u2014 booking, payments and operations for Nigerian tour operators (MVP)",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @okapigo/db migrate",
    "db:reset": "pnpm --filter @okapigo/db reset",
    "db:seed": "pnpm --filter @okapigo/db seed",
    "db:studio": "pnpm --filter @okapigo/db studio",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v && docker compose up -d --wait"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  }
}
