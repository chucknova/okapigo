# Copy this file to `.env` (which git ignores) and adjust if needed:
#   cp .env.example .env
#
# The values below match docker-compose.yml, so they work as-is for local development.
# Only test/sandbox keys ever go in here. The API will refuse live payment keys (from session 9).

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000

# PostgreSQL — format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://okapigo:okapigo@localhost:5432/okapigo

# Redis — used for background jobs (BullMQ) from session 6
REDIS_URL=redis://localhost:6379

# Secret for hashing one-time sign-in codes. At least 32 characters; never commit a real one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# --- Payments (stage 10b) ---------------------------------------------------
# "simulator" works with no account (tests, offline demos). "paystack" uses Paystack TEST mode.
PAYMENT_PROVIDER=simulator
# Paystack TEST keys: dashboard → Settings → API Keys & Webhooks, with "Test Mode" on.
# They start with sk_test_ and pk_test_. The app REFUSES to start with a live key.
# Never commit real keys: .env is git-ignored; only this example file is committed.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional: signing secret for the SIMULATOR's webhooks (a default is used if empty).
SIMULATOR_WEBHOOK_SECRET=
# --- The AI trip companion (stage 18a) ------------------------------------------
# fake: answers from the tours' FAQs by matching words, no network. anthropic: Claude Haiku
# (needs ANTHROPIC_API_KEY, from console.anthropic.com → API keys; keep it secret).
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
# The most the companion may spend in a calendar month, in US dollars (default 10).
AI_MONTHLY_CAP_USD=10

# --- Photos and logos (stage 19b-1) ---
# Where uploaded pictures are kept, and the address they're served from. Leave both empty:
# the repo's .data/media folder (git-ignored), served by the API at API_PUBLIC_URL/media.
# At deploy they move to Cloudflare R2.
MEDIA_DIR=
MEDIA_PUBLIC_URL=
# --- Email (stage 14b) --------------------------------------------------------
# mailpit: every email lands in a local mailbox, http://localhost:8025 (pnpm services:up
# starts it). Nothing leaves your laptop. resend: real email (needs RESEND_API_KEY).
EMAIL_PROVIDER=mailpit
# RESEND_API_KEY=
# Without your own domain, Resend only allows this sender, and only to your own address.
# EMAIL_FROM=onboarding@resend.dev
# --- WhatsApp Cloud API (stage 13c-3) ----------------------------------------
# Optional: without these, guests chat in the simulator only (/simulator/whatsapp/).
# Set-up, step by step: docs/learning/13c-3-whatsapp-cloud-api.md. Never commit real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# A long random string you choose, and type into Meta's webhook settings too.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0
# The language the six message templates were approved in (stage 14c).
# WHATSAPP_TEMPLATE_LANGUAGE=en
# The API's public address. Paystack sends guests back here after paying.
API_PUBLIC_URL=http://localhost:4000
# Where guests see booking links (used in link previews). Empty = same as API_PUBLIC_URL.
WEB_PUBLIC_URL=

# --- OTAs through OCTO (session 17) ---
# The seed gives the demo business a "Sojourna" channel (the mock OTA, apps/mock-ota). Its API key is octo_dev_<business slug>
# unless you set one here (the deployed demo should). Only the key's SHA-256 is stored.
# MOCK_OTA_API_KEY=
# Sojourna itself (apps/mock-ota, `pnpm dev` starts it on http://localhost:4400): where it finds
# the business's OCTO API, and where it keeps its own bookings. The defaults suit local dev.
# OKAPIGO_OCTO_URL=http://localhost:4000/octo
# MOCK_OTA_PORT=4400
# MOCK_OTA_DATA=apps/mock-ota/data/sojourna.json

# --- The public demo (stage 19a-2) -----------------------------------------------------
# on: the workers wipe the demo business and make it again every night at 04:00 Lagos time,
# with its history. Only for the deployed demo: leave it off here, or your own data goes.
# (It never touches a business that isn't a demo one. `pnpm demo:reset` does it by hand.)
DEMO_RESET=
# Which business is the demo (default irin-lagos-tours).
DEMO_SLUG=
