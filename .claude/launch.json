{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-files",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4890",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/designs"
      ],
      "port": 4890
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@okapigo/web", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@okapigo/api", "dev"],
      "port": 4000
    }
  ]
}
